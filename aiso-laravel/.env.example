APP_NAME=AISO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=en

# Database: SQLite file by default (database/database.sqlite). For MySQL or PostgreSQL set DB_CONNECTION and the rest.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=aiso
# DB_USERNAME=aiso
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
# Over plain HTTP on a non-localhost host set this to false, otherwise the browser will not keep the session cookie.
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=info

# Seeds OWNER, MANAGER, USER_1..3 on the first migrate --seed (only when the user table is empty).
AISO_SEED_ENABLED=true
AISO_SEED_PASSWORD=ChangeMe!123
# Also load the sample workbook (16 operations) with the seed, so the screens have data to show.
AISO_SEED_DEMO_DATA=true
# Language of system-generated texts on a fresh install ("fa" or "en"); the owner can change it in Settings.
AISO_LANGUAGE=fa

# AI assignment method (optional): GapGPT, an OpenAI-compatible API. The owner normally enters the token and model in the
# owner console; these values apply only when nothing is entered there.
AISO_LLM_API_KEY=
AISO_LLM_MODEL=gapgpt-gemma-26b-a4b
AISO_LLM_BASE_URL=https://api.gapgpt.app/v1
# Certificate bundle file for HTTPS calls to the AI service and Bale. Needed when PHP has no curl.cainfo (common on Windows,
# error "cURL error 60"): download cacert.pem from curl.se, or use the ca-bundle.crt that comes with Git. Leave empty otherwise.
AISO_CA_BUNDLE=
AISO_LLM_TIMEOUT=300
AISO_LLM_EMBEDDING_TIMEOUT=30
AISO_EMBEDDING_BASE_URL=
AISO_LLM_MAX_TOKENS=4096
AISO_LLM_FALLBACK=true
# The assistant: "dialogue" (stateful, reads on demand, small context) or "legacy" (full briefing every call)
AISO_AGENT_ENGINE=dialogue
# The first gate (read / action / chat / clarify) before the model decides; one extra small call per new topic
AISO_AGENT_GATE=true
# Minutes a question waiting for a missing parameter stays valid
AISO_DIALOGUE_PENDING_TTL=30
# Keep the full model input of each step in the owner's assistant log (false: only its size)
AISO_AGENT_LOG_PAYLOADS=true
# The assistant decides details itself from the organisation's data instead of asking (changes still need approval)
AISO_AGENT_AUTONOMY=true
# Working calendar for the schedule: Sat-Wed 08:00-16:00, Thu 08:00-12:00 (config aiso.calendar); false = 24/7
AISO_WORK_CALENDAR=true
AISO_WORK_TIMEZONE=Asia/Tehran
# Days without work, comma separated (Y-m-d, local)
AISO_HOLIDAYS=
# Blocked work is planned to wait this many working hours (when the block is lifted is unknown)
AISO_BLOCKED_RELEASE_HOURS=8
AISO_RESPONSIBLE_BONUS_HOURS=8

# Bale messenger connector (optional). Used only when Settings > Messenger platform is BALE.
# Create the bot with @BotFather in Bale. The owner can also set the token in Settings (stored encrypted); this is the fallback.
BALE_BOT_TOKEN=
# Bot API base URL (default: Bale's public API). Change only if Bale tells you to.
BALE_API_URL=https://tapi.bale.ai

# Software vendor console: the vendor signs in on the normal form and gets a separate panel (licence, owner, starting data).
# Only hashes live here. Create them with: php artisan aiso:vendor-credentials   (leave empty to switch the console off)
AISO_VENDOR_SALT=
AISO_VENDOR_USER_HASH=
AISO_VENDOR_PASSWORD_HASH=
AISO_VENDOR_IDLE_MINUTES=30
